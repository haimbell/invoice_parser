# Copy to .env and `source .env` (or use direnv) before running.

# Folder containing your invoice PDFs (scanned recursively). The master CSV
# lives at $INVOICES_DIR/invoice_report.csv.
INVOICES_DIR=/path/to/your/invoices

# Account emails stamped onto parsed rows. Personal is the default; business
# is used for vendors known to be company-owned (Cloudflare, Slack, etc.) and
# for DigitalOcean invoices that mention your business name.
PERSONAL_EMAIL=you@example.com
BUSINESS_EMAIL=you@yourcompany.com

# Required only when using Claude fallback for unknown vendors.
ANTHROPIC_API_KEY=
